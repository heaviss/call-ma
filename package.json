{
  "name": "call-ma",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.22"
  },
  "packageManager": "npm@10.8.1",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "lint": "eslint . && npm run lint:css && npm run lint:html",
    "lint:fix": "eslint . --fix && npm run lint:css:fix && npm run lint:html:fix",
    "lint:css": "stylelint \"index.html\" \"src/public/**/*.html\"",
    "lint:css:fix": "stylelint --fix \"index.html\" \"src/public/**/*.html\"",
    "lint:css:baseline": "stylelint \"index.html\" \"src/public/**/*.html\" --suppress && git diff --exit-code stylelint-suppressions.json",
    "lint:html": "html-validate \"index.html\" \"src/public/**/*.html\"",
    "lint:html:fix": "html-validate --fix \"index.html\" \"src/public/**/*.html\"",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@html-eslint/eslint-plugin": "^0.67.0",
    "@html-eslint/parser": "^0.67.0",
    "@playwright/test": "^1.61.1",
    "@trystero-p2p/core": "^0.26.0",
    "@types/jsdom": "^28.0.3",
    "@types/node": "^24.19.2",
    "@types/qrcode": "^1.5.6",
    "@vitest/coverage-v8": "^4.1.6",
    "@vitest/eslint-plugin": "^1.6.28",
    "eslint": "^10.14.0",
    "eslint-plugin-playwright": "^2.12.2",
    "eslint-plugin-unicorn": "^79.0.0",
    "globals": "^17.14.0",
    "html-validate": "^11.18.0",
    "jsdom": "^29.1.1",
    "postcss-html": "^1.8.1",
    "prettier": "^3.8.3",
    "stylelint": "^17.11.1",
    "stylelint-config-html": "^1.1.0",
    "stylelint-config-recess-order": "^7.10.0",
    "stylelint-config-standard": "^40.0.0",
    "stylelint-declaration-strict-value": "^1.12.1",
    "stylelint-high-performance-animation": "^2.0.0",
    "stylelint-order": "^8.1.3",
    "stylelint-plugin-logical-css": "^2.1.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.0.13",
    "vite-plugin-node-polyfills": "^0.28.0",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.6"
  },
  "dependencies": {
    "@trystero-p2p/ipfs": "^0.26.0",
    "@trystero-p2p/mqtt": "^0.26.0",
    "@trystero-p2p/nostr": "^0.26.0",
    "@trystero-p2p/torrent": "^0.26.0",
    "qrcode": "^1.5.4"
  }
}
