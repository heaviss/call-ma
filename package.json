  "private": true,
  "type": "module",
  "engines": {
    "node": ">=18.0.0"
  },
  "packageManager": "npm@10.8.1",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "lint": "eslint . && npm run lint:css",
    "lint:fix": "eslint . --fix && npm run lint:css:fix",
    "lint:css": "stylelint \"index.html\" \"src/public/**/*.html\"",
    "lint:css:fix": "stylelint --fix \"index.html\" \"src/public/**/*.html\"",
    "format": "prettier . --write",
    "format:check": "prettier . --check"
  },
  "devDependencies": {
    "@eslint-community/eslint-plugin-eslint-comments": "^4.8.1",
    "@eslint/js": "^10.0.1",
    "@html-eslint/eslint-plugin": "^0.67.0",
    "@html-eslint/parser": "^0.67.0",
    "@playwright/test": "^1.61.1",
    "@trystero-p2p/core": "^0.26.0",
    "@vitest/coverage-v8": "^4.1.6",
    "@vitest/eslint-plugin": "^1.6.28",
    "eslint": "^10.14.0",
    "eslint-plugin-de-morgan": "^2.3.0",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-no-unsanitized": "^4.1.5",
    "eslint-plugin-playwright": "^2.12.2",
    "eslint-plugin-promise": "^7.3.0",
    "eslint-plugin-regexp": "^3.3.3",
    "eslint-plugin-security": "^4.2.1",
    "eslint-plugin-sonarjs": "^4.2.2",
    "eslint-plugin-unicorn": "^79.0.0",
    "globals": "^17.14.0",
    "jsdom": "^29.1.1",
    "postcss-html": "^1.8.1",
    "prettier": "^3.8.3",
    "stylelint": "^17.11.1",
    "stylelint-config-html": "^1.1.0",
    "stylelint-config-standard": "^40.0.0",
    "vite": "^8.0.13",
    "vite-plugin-node-polyfills": "^0.28.0",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.6"
  },
  "dependencies": {
    "@trystero-p2p/ipfs": "^0.26.0",
    "@trystero-p2p/mqtt": "^0.26.0",
    "@trystero-p2p/nostr": "^0.26.0",
